{
  "name": "matrix_odoo",
  "version": "1.0.0",
  "description": "Цей скрипт автоматично створює товари з атрибутами, специфікації (BOMs) та операції в Odoo 19 через API.",
  "main": "index.js",
  "scripts": {
    "to-novalid": "ts-node src/index.ts to-novalid",
    "validate": "ts-node src/index.ts validate",
    "validate-all": "ts-node src/index.ts validate-all",
    "import": "ts-node src/index.ts import",
    "check": "ts-node src/index.ts check",
    "ai-check": "ts-node src/index.ts ai-check",
    "add-fabric": "ts-node src/index.ts add-fabric",
    "snapshot": "ts-node src/index.ts snapshot",
    "restore": "ts-node src/index.ts restore",
    "dev": "ts-node src/index.ts",
    "export-json": "ts-node src/commands/exportJson.ts",
    "import-json": "ts-node src/commands/importJson.ts",
    "migrate-attr": "ts-node src/commands/migrateAttrValues.ts",
    "import-json-batch": "ts-node src/commands/importJsonBatch.ts",
    "set-routes": "ts-node src/commands/setRoutes.ts",
    "check-chain": "ts-node src/tools/check-chain.ts",
    "check-attrs": "ts-node src/tools/check-attributes.ts",
    "check-all": "ts-node src/tools/check-all.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "import-template-bom": "ts-node src/commands/importTemplateBom.ts",
    "fix-product-types": "ts-node src/commands/fixProductTypes.ts",
    "diagnose-mo": "ts-node src/tools/diagnose-mo.ts",
    "find-no-category": "ts-node src/tools/find-no-category.ts",
    "sync-base": "ts-node src/tools/sync-base.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^7.1.3"
  }
}
